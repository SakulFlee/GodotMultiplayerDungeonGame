; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/color_arrays=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false

[application]

config/name="Multiplayer Dungeon Game"
config/tags=PackedStringArray("game", "private")
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.2", "C#")

[autoload]

BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
BetterTerrain="*res://addons/better-terrain/BetterTerrain.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
OrchestratorNodeFactory="*res://addons/orchestrator/orchestrator_node_factory.gd"
Orchestrator="*res://addons/orchestrator/orchestrator.gd"
RunConfigManager="*res://addons/run-configs/run-config-manager.gd"

[dotnet]

project/assembly_name="GodotMultiplayerDungeonGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/Asset_Drawer/plugin.cfg", "res://addons/DestructiblesCSharp/plugin.cfg", "res://addons/anthonyec.camera_preview/plugin.cfg", "res://addons/beehave/plugin.cfg", "res://addons/better-terrain/plugin.cfg", "res://addons/camera_2d_plus/plugin.cfg", "res://addons/cognite/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/editor_physics/plugin.cfg", "res://addons/godot-box2d/plugin.cfg", "res://addons/gui_auto_layout/plugin.cfg", "res://addons/markdownlabel/plugin.cfg", "res://addons/match_maker/plugin.cfg", "res://addons/nklbdev.importality/plugin.cfg", "res://addons/orchestrator/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/run-configs/plugin.cfg", "res://addons/sprite_painter/plugin.cfg", "res://addons/visual_signals_3d/plugin.cfg", "res://addons/webrtc_sipsorcery/plugin.cfg")

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"echo":false,"script":null)
]
}
move_down={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":83,"key_label":0,"unicode":115,"echo":false,"script":null)
]
}
move_left={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"echo":false,"script":null)
]
}
move_right={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"echo":false,"script":null)
]
}

[physics]

2d/physics_engine="Box2D"

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/canvas_textures/default_texture_repeat=1
driver/threads/thread_model=2
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/decals/filter=0
textures/light_projectors/filter=0
anti_aliasing/quality/msaa_2d=2
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
occlusion_culling/quality/use_debanding=false
occlusion_culling/quality/use_taa=false
occlusion_culling/quality/msaa_2d=1
