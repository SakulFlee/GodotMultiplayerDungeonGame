; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/color_arrays=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false

[application]

config/name="Multiplayer Dungeon Game"
config/tags=PackedStringArray("game", "private")
run/main_scene="res://Scenes/GameModes/Main.tscn"
config/features=PackedStringArray("4.2", "C#")

[autoload]

BeehaveGlobalMetrics="*res://addons/beehave/metrics/beehave_global_metrics.gd"
BeehaveGlobalDebugger="*res://addons/beehave/debug/global_debugger.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
RunConfigManager="*res://addons/run-configs/run-config-manager.gd"

[dotnet]

project/assembly_name="GodotMultiplayerDungeonGame"

[editor_plugins]

enabled=PackedStringArray("res://addons/DestructiblesCSharp/plugin.cfg", "res://addons/beehave/plugin.cfg", "res://addons/dialogue_manager/plugin.cfg", "res://addons/markdownlabel/plugin.cfg", "res://addons/match_maker/plugin.cfg", "res://addons/nklbdev.importality/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/run-configs/plugin.cfg", "res://addons/visual_signals_3d/plugin.cfg", "res://addons/webrtc_sipsorcery/plugin.cfg")

[file_customization]

folder_colors={
"res://Cells/Base/": "red",
"res://Cells/Stone/": "gray"
}

[input]

move_up={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":119,"echo":false,"script":null)
]
}
